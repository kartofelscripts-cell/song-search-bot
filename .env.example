# Token from @BotFather (Telegram). REQUIRED.
BOT_TOKEN=

# Optional. Default: INFO. One of DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# Optional. Directory where downloaded tracks are stored and cached.
DOWNLOADS_DIR=./downloads

# Optional. Maximum size of the file sent to a user, in megabytes.
# Telegram Bot API limit for upload is 50 MB without a local Bot API server,
# and up to 2000 MB with a self-hosted local Bot API server.
MAX_FILE_SIZE_MB=50

# Optional. Maximum allowed track duration, in seconds (default 1800 = 30 min).
MAX_DURATION_S=1800

# Optional. How many search results to return per query (max 25).
SEARCH_LIMIT=8

# Optional. TTL of in-memory search-result cache, in seconds.
CACHE_TTL_S=1800
